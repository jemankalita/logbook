{
  "manifest_version": 3,
  "name": "Save to Logbook",
  "version": "1.0.0",
  "description": "Save the current page, a link or selected text to your Logbook.",
  "permissions": ["contextMenus", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Save this page to Logbook", "default_icon": { "128": "icon.png" } },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page to Logbook"
    }
  }
}
