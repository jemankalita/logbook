# Password to unlock the site (min 12 chars; 20+ random recommended). Only you know it.
APP_PASSWORD=use-a-long-random-password
# Signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Your timezone — decides when "today" rolls over for attendance.
APP_TIMEZONE=Asia/Kolkata
# Optional: your first name for the dashboard greeting ("Good morning, Sam").
OWNER_NAME=
# Leave empty locally (uses the embedded database in .data/).
# In production: Supabase → Connect → Connection string → "Session pooler" (port 5432).
# Not the transaction pooler (6543) — requests hang there. Remove the [ ] around the password.
DATABASE_URL=
# Google Calendar "Secret address in iCal format" (Settings → your calendar → Integrate calendar).
# Several calendars: separate with commas. Treat like a password.
GOOGLE_CALENDAR_ICS_URLS=
# One-time Notion import (Library → Import). Create an internal integration at
# notion.so/profile/integrations, connect it to your top page (⋯ → Connections),
# then paste the secret and the page's link here. Remove both after importing.
NOTION_TOKEN=
NOTION_ROOT_PAGE=
# Optional: lets a scheduled job download backups (GET /api/backup with "Authorization: Bearer <token>").
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_TOKEN=
